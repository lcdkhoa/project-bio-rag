# Biology RAG Sample Environment File
# Copy this file to .env and fill in your values

# HuggingFace Token (required for LLM model download)
HF_TOKEN=your_huggingface_token_here

# Gemini API Key (optional, for future use)
GEMINI_API_KEY=

# --- LLM đánh giá (sinh test + chấm câu trả lời) — bộ test trong src/test/ ---
# Dùng endpoint OpenAI-compatible nên cắm được MiMo / Groq / OpenRouter / vLLM...
# Ví dụ Xiaomi MiMo (điền base_url + model id theo nhà cung cấp token của bạn):
#   EVAL_LLM_BASE_URL=https://api.<...>/v1
#   EVAL_LLM_MODEL=mimo-2.5-pro
# Ví dụ Groq (free):
#   EVAL_LLM_BASE_URL=https://api.groq.com/openai/v1
#   EVAL_LLM_MODEL=llama-3.3-70b-versatile
# Ví dụ OpenRouter (đang dùng, đo được 2026-08-23):
#   EVAL_LLM_BASE_URL=https://openrouter.ai/api/v1      <-- DỪNG Ở /v1
#   EVAL_LLM_MODEL=stealth/ox-alpha
#   BẪY ĐÃ ĐO: để nguyên URL copy từ tài liệu OpenRouter
#   (.../v1/chat/completions) thì client OpenAI nối thêm "/chat/completions"
#   lần nữa -> 404 Not Found. Bỏ đuôi đi thì 200 OK.
#   CẤM đặt max_tokens: completion_tokens đo được ~5 lần số token chữ nhìn thấy
#   (139 token cho câu trả lời 81 ký tự) dù API báo reasoning_tokens = 0.
#   Độ trễ đo được: 4,4-6 s/câu, nhưng có ca 59 s và 63 s -> để timeout >= 120 s.
EVAL_LLM_BASE_URL=
EVAL_LLM_API_KEY=
EVAL_LLM_MODEL=
# Tùy chọn: số câu hỏi mỗi sách (mặc định 12)
EVAL_QUESTIONS_PER_BOOK=12

# Use GPU for LLM inference
USE_GPU=true

# Data and database locations
# Leave RAG_DATABASE_DIR empty for local ./database.
# On Google Colab, point this to Google Drive so Chroma, status, image crops,
# manifest, and caption cache survive runtime disconnects.
# RAG_DATA_DIR: ẢNH TRANG. Từ 2026-08-23 `datasources/` KHÔNG nằm trong git
# (D-68: 4,1 GB / 2 399 trang), nên trên Colab biến này PHẢI trỏ sang Drive.
# Trỏ vào chỗ trống thì --text-only/--image-only/--etl thoát mã 2 (không im lặng).
RAG_DATA_DIR=
RAG_DATABASE_DIR=
# RAG_MANIFEST_DIR + RAG_FINGERPRINT_DIR: hai thứ này là KẾT QUẢ ĐO đã commit nên
# mặc định đi theo REPO, không theo RAG_DATABASE_DIR — để index nằm Drive mà không
# phải copy tay. Đo lại fingerprint tốn ~70 phút OCR cho 12 quyển.
RAG_MANIFEST_DIR=
RAG_FINGERPRINT_DIR=
# Example for Colab:
# RAG_DATABASE_DIR=/content/drive/MyDrive/project_bio_rag/database
# RAG_DATA_DIR=/content/drive/MyDrive/project_bio_rag/datasources

# Windows/local PDF OCR dependencies
# TESSERACT_CMD can be just "tesseract" if tesseract.exe is already in PATH.
# POPPLER_PATH can be empty if Poppler's bin directory is already in PATH.
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
POPPLER_PATH=C:/poppler/Library/bin

# Image captioning metadata for extracted figures
# Caption ảnh (Vintern-1B): TẮT theo mặc định — đã đo là bịa chi tiết và
# chậm 17,6 s/crop trên CPU (D-47). Bật = ETL sẽ raise nếu model không nạp được.
IMAGE_CAPTION_ENABLED=false
IMAGE_CAPTION_MODEL=5CD-AI/Vintern-1B-v2
IMAGE_CAPTION_MAX_NEW_TOKENS=96
IMAGE_EXTRACTION_VERSION=v19_pill_kernels
# Bump de ep OCR lai toan bo duong text
TEXT_EXTRACTION_VERSION=v2_bai_spine
OWL_VIT_MODEL=google/owlvit-base-patch32
OWL_VIT_CONFIDENCE_THRESHOLD=0.1
# Leave these empty unless you need a custom path; defaults follow RAG_DATABASE_DIR.
IMAGE_CAPTION_CACHE_PATH=
IMAGE_REVIEW_MANIFEST_PATH=

# Image retrieval breadth
IMAGE_RETRIEVER_K=5
IMAGE_RETRIEVER_FETCH_K=48
IMAGE_METADATA_FETCH_K=64
IMAGE_RELEVANCE_THRESHOLD=0.36

# Logging level
LOG_LEVEL=INFO

# Nhịp log tiến trình của ETL. Mỗi vòng lặp dài (index text từng trang, OCR neo
# caption, crop hình) in một dòng khi tới đủ số trang HOẶC quá số giây — cái nào
# đến trước. Để phân biệt "đang chạy" với "treo"; hạ số giây nếu muốn nhịp dày hơn.
PROGRESS_LOG_EVERY_PAGES=10
PROGRESS_LOG_EVERY_SECONDS=30

# --- M2 redesign: text embedding + reranking (see document/specs/2026-08-18-rag-etl-retrieval-redesign-design.md) ---
# EMBEDDING_MODEL now defaults to BAAI/bge-m3 (1024-dim), replacing the old MiniLM model (384-dim).
# An existing ChromaDB built with MiniLM MUST be rebuilt before use with bge-m3 — a dim
# mismatch is a hard runtime error, not a graceful fallback. See document/runbooks/m2_eval.md.
# Cross-encoder reranking (text + image), all off/default until uncommented:
# RERANK_ENABLED=true
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# ^ Dùng id HF chỉ được khi CÓ mạng. Nếu đặt HF_HUB_OFFLINE=1 thì phải trỏ vào
#   đường dẫn local (RERANK_MODEL=./models/bge-reranker-v2-m3), vì bản tải bằng
#   download_models.py nằm ở ./models chứ không nằm trong cache hub. Sai chỗ này
#   thì rerank TẮT ÂM THẦM: chỉ một dòng warning mỗi truy vấn. Cổng G3 in ra
#   `rerank: ...` để bạn phát hiện.
# RERANK_FETCH_K=20
# RERANK_SCORE_MIN=0.2
# IMAGE_RERANK_ENABLED=true
# IMAGE_RERANK_TOP_N=12
# IMAGE_RERANK_WEIGHT=0.25
